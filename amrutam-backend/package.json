{
  "name": "amrutam-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend assignment starter for a telemedicine platform",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./src/observability/tracing.js src/server.js",
    "start": "node --import ./src/observability/tracing.js src/server.js",
    "worker": "node --import ./src/observability/tracing.js src/jobs/worker.js",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.js",
    "migrate": "node src/db/migrate.js",
    "generate:openapi": "node scripts/generate-openapi.js",
    "validate:openapi": "node scripts/validate-openapi.js",
    "admin:create": "node scripts/create-admin.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.5.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "supertest": "^7.1.4",
    "vitest": "^4.1.12"
  }
}
