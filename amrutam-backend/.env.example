PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://example_user:replace_with_local_password@localhost:5432/amrutam
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
# Required for MFA enrollment/login: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters
# Hosted PostgreSQL should verify TLS. Set false only for local/private Compose networking.
DB_SSL=false
# Optional: enable OTLP traces when a collector is running
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Docker Compose only: use a URL-safe strong database password
# POSTGRES_PASSWORD=replace_with_a_long_random_password
